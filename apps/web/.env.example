# Web client configuration (copy to apps/web/.env.local for local overrides; .env.local is git-ignored).

# Where the Next.js server forwards /api/v1/* requests (API Contract v1.1 §7).
# Local: http://localhost:3000   Docker Compose: http://api-gateway:3000
GATEWAY_URL=http://localhost:3000

# Card data source: "gateway" (default, real requests) or "fixtures" (local
# example data while the gateway proxy is not ready; a warning banner is shown).
# In fixture mode a failure can be forced with ?fixture=stale|upstream-unavailable|rate-limited|network-error
NEXT_PUBLIC_WEB_DATA_SOURCE=gateway
