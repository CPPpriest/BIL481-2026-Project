{
  "name": "@campus-orchestrator/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server Core for Campus Data Orchestrator",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "test": "node tests/verify-mcp-server.mjs && node tests/verify-http-and-mocks.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@campus-orchestrator/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
