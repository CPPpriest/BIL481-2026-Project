# ==============================================================================
# Campus Data Orchestrator - Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Ports
GATEWAY_PORT=3000
MCP_SERVER_PORT=3001
WEB_PORT=3002

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Database Configuration (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_orchestrator?schema=public

# Security & Authentication
JWT_SECRET=dev-jwt-secret-key-change-in-production
MOCK_SSO_ISSUER=campus-mock-sso

# External AI Provider (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here

# Connector Operating Modes (mock | live)
# Per FR-12: Hot-swappable mock/live mode
CAFETERIA_CONNECTOR_MODE=mock
SHUTTLE_CONNECTOR_MODE=mock
LIBRARY_CONNECTOR_MODE=mock
SCHEDULE_CONNECTOR_MODE=mock

# Upstream Timeout Bounds (milliseconds, per NFR-01: max 800ms)
UPSTREAM_TIMEOUT_MS=800

# Cache TTL Configuration (seconds, per FR-09)
CACHE_TTL_CAFETERIA=3600
CACHE_TTL_SHUTTLE=120
CACHE_TTL_LIBRARY=60
CACHE_TTL_COURSE_SCHEDULE=300
